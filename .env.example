# Cloud LLM: required only when a verified permission is consumed for an answer.
OPENAI_API_KEY=
PRIVATEDOCS_OPENAI_MODEL=gpt-5.6-luna

# Real local Midnight TypeScript bridge. The Python client rejects non-loopback
# URLs unless PRIVATEDOCS_ALLOW_REMOTE_BRIDGE=1 is set deliberately.
PRIVATEDOCS_MIDNIGHT_BRIDGE_URL=http://127.0.0.1:8787
PRIVATEDOCS_ALLOW_REMOTE_BRIDGE=0
